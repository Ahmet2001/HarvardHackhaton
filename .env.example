BIDIK_APP_NAME=Bıdık
BIDIK_ENV=development
BIDIK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
BIDIK_DATABASE_PATH=./data/bidik.db
BIDIK_DATA_DIR=./data
BIDIK_JOBS_DIR=./jobs
BIDIK_RCSB_DATA_API_URL=https://data.rcsb.org/rest/v1/core
BIDIK_RCSB_SEARCH_API_URL=https://search.rcsb.org/rcsbsearch/v2/query
BIDIK_PDB_DOWNLOAD_BASE_URL=https://files.rcsb.org/download
BIDIK_PUBCHEM_PUG_REST_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
BIDIK_OBABEL_BINARY=obabel
BIDIK_VINA_BINARY=vina
BIDIK_COMMAND_TIMEOUT_SECONDS=900
BIDIK_HTTP_TIMEOUT_SECONDS=30
BIDIK_ENABLE_GEMINI_AGENT=true
BIDIK_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
